# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=manga_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Mage ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=manga_tracker
MAGE_DATABASE_CONNECTION_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DBNAME}?options=-c%20search_path%3Dmage"

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_PROJECT_NAME=manga_tracker_dbt

# ── Metabase ──────────────────────────────────────────────────────────────────
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional — defaults to redis://redis:6379 if not set
REDIS_URL=redis://redis:6379

# ── MangaDex API ──────────────────────────────────────────────────────────────
# Required for load_mangadex_follows (authenticated endpoints).
# Create a Personal API Client at:
#   mangadex.org → (avatar) → Account Settings → API Clients
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=

# ── Discord webhooks ──────────────────────────────────────────────────────────
# Required for Discord notifications after pipeline runs.
# Create via: Discord channel → Edit Channel → Integrations → Webhooks
DISCORD_CHAPTERS_WEBHOOK_URL=
DISCORD_MANGA_WEBHOOK_URL=
